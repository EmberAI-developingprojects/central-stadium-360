# ── Bridge ────────────────────────────────────────────────────────────────
# Port 1017 on purpose: Windows' WinNAT/Hyper-V port reservations never touch
# ports below 1025, so the bridge survives reboots (7070 kept getting stolen).
PORT=1017
KIOSK_ORIGIN=http://127.0.0.1:8080

# ── Cloud auto-print (tickets + receipts) ─────────────────────────────────
KIOSK_API_BASE=
KIOSK_ID=
KIOSK_KEY=
VENUE_NAME=

# ── Printer ───────────────────────────────────────────────────────────────
PRINTER_NAME=POS80
PRINT_WIDTH_MM=72
PRINT_EBARIMT=on

# ── Golomt card terminal ──────────────────────────────────────────────────
POS_DRIVER=mock
POS_SERVICE_URL=http://localhost:8500/requestToPos/
POS_TERMINAL_ID=
POS_MERCHANT_ID=
# Terminal expects the amount in minor units (möngö, ₮ × 100)
POS_AMOUNT_MULTIPLIER=100
POS_DEBUG=off

# Terminal channel params (Device Manager → the terminal's COM port + baud)
POS_COM_PORT=
POS_BAUDRATE=115200
# Card-flow timeout in MILLISECONDS (tap + PIN + host round trip)
POS_EXCHANGE_TIMEOUT_MS=180000

# ── E-Barimt (PosAPI 3.0 on this box) ─────────────────────────────────────
EBARIMT_POSAPI_URL=http://localhost:7080
EBARIMT_DISTRICT_CODE=
EBARIMT_BRANCH_NO=1
EBARIMT_CLASSIFICATION_CODE=
EBARIMT_VATABLE=true
EBARIMT_MERCHANT_NAME=
EBARIMT_MERCHANT_TIN=
EBARIMT_POS_NO=1

# ── Email (optional) ──────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
