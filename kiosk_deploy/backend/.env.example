# kiosk-bridge config on the kiosk box. Loopback-only service.
# Copy to `.env` on the kiosk box, then fill in the box-specific values.

PORT=7070

# The web kiosk's origin (run_web_kiosk.ps1 serves on 8080) — must match exactly
# so the bridge's CORS/PNA check passes.
KIOSK_ORIGIN=http://127.0.0.1:8080

# On-box E-Barimt PosAPI 3.0 (card-rail fiscal receipts).
EBARIMT_POSAPI_URL=http://localhost:7080
# Location identity stamped on issued barimt. districtCode is the tax district
# (сум/дүүрэг) code; branchNo must be numeric. NOTE: 3420 is the staging test
# value — set these to the stadium's real codes before production.
EBARIMT_DISTRICT_CODE=3420
EBARIMT_BRANCH_NO=1
EBARIMT_CLASSIFICATION_CODE=9329900
EBARIMT_VATABLE=true

# Card POS terminal (Golomt Integrated POS).
#
# The Golomt on-box WCF service is installed from GLMTPOS.msi and listens at
# http://localhost:8500/requestToPos/ (see PobRestService.exe.config). The
# `golomt` driver talks to it over a single WCF endpoint:
#     GET /requestToPos/message?data={base64(json)}
#
# Leave POS_DRIVER=mock on any box without a real terminal (dev machines,
# staging). Flip to `golomt` on the actual kiosk box AFTER installing:
#     "C:\Windows\Microsoft.NET\Framework\v4.0.30319\installutil.exe" \
#       "C:\Program Files (x86)\Golomt\Golomt POS API\PobRestService\PobRestService.exe"
# ...and starting the "PobRestService" Windows service.
POS_DRIVER=mock
POS_SERVICE_URL=http://localhost:8500/requestToPos/

# Terminal identity — issued by Golomt when they provision this kiosk.
# Leave blank until the box is provisioned.
POS_TERMINAL_ID=
POS_MERCHANT_ID=

# --- Golomt-spec overrides (adjust once Golomt confirms) --------------------
# The DualConnector.dll enum has SAO_SALE / SAO_VOID / SAO_REFUND /
# SAO_SETTLEMENT operations but does not expose their integer codes over the
# REST envelope. These defaults are placeholders; correct them per Golomt's
# integration doc when it arrives (the request will simply be rejected until
# the real codes are set).
POS_OP_SALE=200
POS_OP_VOID=201
POS_OP_REFUND=202
POS_OP_SETTLEMENT=500

# 1 = amount is passed as whole tögrөg. Switch to 100 if Golomt expects minor
# units (1/100 ₮). The Debug log for a test sale shows [04]='496' — consistent
# with whole ₮ — so 1 is the current best guess.
POS_AMOUNT_MULTIPLIER=1

# Response `Status` value that means the sale was authorised. Overridable in
# case Golomt returns "APPROVED" / "OK" / etc. in a different case or word.
POS_APPROVED_STATUS=approved

# Card taps + PIN entry can take a while on an unattended kiosk. 3 minutes is
# the default abort window; raise if buyers routinely hit the timeout.
POS_REQUEST_TIMEOUT_MS=180000

# Set to `on` (or `1`) to have GolomtTerminal log every request/response
# envelope to the console AND expose POST /pos/probe for raw payload testing.
# Leave OFF in normal operation.
POS_DEBUG=off

# Thermal printer for tickets + И-Баримт.
PRINTER_NAME=POS80
PRINT_WIDTH_MM=72

# Auto-print the И-Баримт fiscal receipt to POS80 as soon as POSAPI issues it
# (i.e. right after a successful card sale). Turn off if the Flutter client
# does its own /print/receipt call; on by default so the operator gets paper
# out-of-the-box.
PRINT_EBARIMT=on

# Email the digital ticket + И-Баримт (optional). Empty key => simulate mode
# (no mail sent). Set both to enable real delivery via Resend.
RESEND_API_KEY=
EMAIL_FROM=Tsengeldekh Stadium <tickets@stadium.mn>
EMAIL_REPLY_TO=

# --- Cloud auto-print -------------------------------------------------------
# The kiosk web build does not call the bridge's /print routes itself, so the
# bridge polls the cloud for this box's PAID orders and prints the entry
# tickets automatically. KIOSK_KEY is the same X-Kiosk-Key the UI was built
# with; KIOSK_ID must match the id the UI sells under.
KIOSK_API_BASE=https://cs360-backend-190017495951.asia-northeast1.run.app
KIOSK_ID=gate-1
VENUE_NAME=Үндэсний Төв Цэнгэлдэх
KIOSK_KEY=

# И-Баримтын цаасан хэвлэлийн толгойд гарах байгууллагын хуулийн мэдээлэл
# (ТЕГ-ын стандарт: нэр, ТТД, кассын №). ТТД-гээ ЗААВАЛ бөглөнө үү!
EBARIMT_MERCHANT_NAME=Үндэсний Төв Цэнгэлдэх Хүрээлэн
EBARIMT_MERCHANT_TIN=
EBARIMT_POS_NO=1
