# kiosk-bridge configuration (copy to .env on the kiosk box)

# Port the bridge listens on (localhost only).
PORT=7070

# The kiosk web UI origin allowed to call this bridge (CORS).
# Use the hosted kiosk URL in production, http://localhost:PORT in dev.
KIOSK_ORIGIN=https://kiosk.tsengeldeh.mn

# On-box E-Barimt POSAPI 3.0 base URL (local service).
EBARIMT_POSAPI_URL=http://localhost:7080

# On-box card POS terminal service/SDK base URL (used by HTTP/SDK drivers).
POS_SERVICE_URL=http://localhost:7081

# Card terminal driver: mock (default, no hardware) | verifone | golomt.
POS_DRIVER=mock
# --- Verifone ECR (serial/USB) — used when POS_DRIVER=verifone ---
# Windows COM port the terminal enumerates as (USB-CDC). Check Device Manager.
POS_SERIAL_PORT=COM3
# Line speed — nominal over USB-CDC, real on RS-232. Match the terminal config.
POS_SERIAL_BAUD=9600
# Link ACK timeout (ms) and full-sale timeout incl. cardholder action (ms).
POS_ACK_TIMEOUT_MS=4000
POS_RESPONSE_TIMEOUT_MS=120000

# --- Email (Resend) — digital ticket + И-Баримт delivery ---
# Get a key at https://resend.com. If left empty, the /email route runs in
# simulate mode (validates + renders but sends nothing) so dev works keyless.
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend (e.g. stadium.mn).
EMAIL_FROM=Tsengeldekh Stadium <tickets@stadium.mn>
# Optional reply-to (support inbox). Leave empty to omit.
EMAIL_REPLY_TO=
