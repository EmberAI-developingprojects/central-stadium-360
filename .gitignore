# Dependencies
node_modules/
**/node_modules/

# Lock files — pnpm only (never commit npm/yarn lock)
package-lock.json
**/package-lock.json
yarn.lock
**/yarn.lock

# Build output
dist/
build/
.vite/

# Environment + secrets
.env
.env.*
!.env.example
*.pem

# Editor / OS noise
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# Local agent state
.claude/

# TinyMCE self-hosted assets (generated from tinymce npm package via postinstall)
frontend/public/tinymce/

# Local archives accidentally created in the repo (e.g. backups, rar/zip exports)
frontend.rar
*.rar
*.zip
env-vars.yaml

# --- kiosk_deploy: this is a deployable bundle, not source ---
# The kiosk box runs `node dist/server.js`, so the built bridge IS the artifact
# we ship. Same for its own package-lock (kiosk box uses npm, not pnpm).
!kiosk_deploy/backend/dist/
!kiosk_deploy/backend/package-lock.json

# Vendor POS drivers (Golomt IPPOS + Verifone) — 33 MB of .rar/.msi archives,
# distribute out-of-band (Google Drive / USB) instead of via git.
kiosk_deploy/IPPOS*/
