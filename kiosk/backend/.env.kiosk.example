# ============================================================
#  kiosk-bridge PRODUCTION config for the on-box kiosk.
#  Copy to .env inside the deployed bridge folder and fill the blanks.
#
#  This template assumes the kiosk UI is SERVED LOCALLY by
#  tool\kiosk\run_web_kiosk.ps1 on http://127.0.0.1:8080, and the
#  card terminal goes through the Golomt GLMTPOS REST service.
# ============================================================

# Bridge listen port (loopback only).
PORT=7070

# CORS origin the UI is served from. MUST match the port run_web_kiosk.ps1 uses
# (default 8080). If you change -Port there, change this to match, or the
# bridge will reject the UI's requests.
KIOSK_ORIGIN=http://127.0.0.1:8080

# --- Card terminal: Golomt IPPOS (GLMTPOS REST service on :8500) ---
POS_DRIVER=golomt
GOLOMT_POS_URL=http://localhost:8500/requestToPos
# REQUIRED: the Golomt-assigned terminal id (TID) for THIS kiosk. Without it
# the golomt driver cannot transact. Get it from Golomt.
GOLOMT_TERMINAL_ID=
GOLOMT_CURRENCY_CODE=496
GOLOMT_POS_TIMEOUT_MS=540000
GOLOMT_POS_HTTP_TIMEOUT_MS=560000
# Transaction mode fields: leave EMPTY (verified) so the terminal waits for a
# card and accepts all entry methods incl. contactless. Do NOT set to "0".
GOLOMT_CMODE=
GOLOMT_CMODE2=
GOLOMT_CARD_ENTRY_MODE=
# Only if the GLMTPOS service does NOT already own the COM port in its
# DualConnector.xml. On the verified box the terminal was COM9 -> "9".
#GOLOMT_POS_PORT=COM9
#GOLOMT_POS_BAUD=115200
# CONFIRM these operationCode values against Golomt's REST doc before go-live.
#GOLOMT_OP_SALE=1
#GOLOMT_OP_VOID=2
#GOLOMT_OP_REFUND=3
#GOLOMT_OP_SETTLEMENT=9

# --- On-box E-Barimt POSAPI 3.0 (fiscal receipt) ---
EBARIMT_POSAPI_URL=http://localhost:7080
EBARIMT_DISTRICT_CODE=3420
EBARIMT_BRANCH_NO=1
EBARIMT_CLASSIFICATION_CODE=9329900
EBARIMT_VATABLE=true

# --- Receipt printer (Windows spooler name) ---
PRINTER_NAME=POS80
PRINT_WIDTH_MM=72

# --- Email (Resend) for digital ticket + E-Barimt delivery ---
# Leave RESEND_API_KEY empty to run email in simulate mode (renders, sends
# nothing). Set it for real delivery.
RESEND_API_KEY=
EMAIL_FROM=Tsengeldekh Stadium <tickets@stadium.mn>
EMAIL_REPLY_TO=
